@model List<AuditLog>
@{
    ViewData["Title"] = "Audit log";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    int pageNo = ViewBag.Page, totalPages = ViewBag.TotalPages, total = ViewBag.Total;
    string? scope = ViewBag.Scope;

    (string Css, string Icon) Style(string action) => action switch
    {
        var a when a.StartsWith("User.") => ("au-user", "fa-user-gear"),
        var a when a.StartsWith("Report.") => ("au-report", "fa-flag"),
        var a when a.EndsWith("ContactShared") => ("au-privacy", "fa-user-lock"),
        var a when a.EndsWith("Deleted") => ("au-danger", "fa-trash"),
        var a when a.StartsWith("Location.") => ("au-muted", "fa-location-arrow"),
        var a when a.StartsWith("Donor.") => ("au-user", "fa-id-card"),
        _ => ("au-request", "fa-hand-holding-medical")
    };

    var actionGroups = new (string Value, string Label)[]
    {
        ("", "All actions"), ("User.", "User accounts & roles"), ("Report.", "Moderation"),
        ("Request.ContactShared", "Contact shared"), ("Request.", "Requests"),
        ("Donor.", "Donor changes"), ("Location.", "Locations")
    };

    object Route(int p) => new { who = ViewBag.Who, type = ViewBag.ActionFilter, scope, from = ViewBag.From, to = ViewBag.To, page = p };
}

@section Head {
    <style>
        .au-ico { flex: 0 0 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: .85rem; }
        .au-user { background: #f3e8ff; color: #6f42c1; }
        .au-report { background: #fff3cd; color: #997404; }
        .au-privacy { background: #e7f1ff; color: #0a58ca; }
        .au-danger { background: #fdecee; color: #b02a37; }
        .au-muted { background: #f1f3f5; color: #6c757d; }
        .au-request { background: #e6f4ea; color: #146c43; }
        .au-row { display: flex; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #f1f3f5; }
        .au-row:last-child { border-bottom: 0; }
        .au-meta { font-size: .75rem; color: #898781; }
        .au-code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .72rem; background: #f8f9fa; border-radius: 6px; padding: 1px 6px; color: #52514e; }
    </style>
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        <div>
            <h1 class="h3 mb-0"><i class="fas fa-clipboard-list text-danger me-2"></i>Audit log</h1>
            <div class="text-muted small">
                Read-only record of who did what and when. Every admin action is recorded here and cannot be edited or deleted.
            </div>
        </div>
        <div class="small text-muted">
            <span class="badge bg-light text-dark border me-1">@total entries</span>
            <span class="badge bg-light text-dark border">@ViewBag.AdminActionsToday admin action(s) today</span>
        </div>
    </div>

    <!-- Filters (one row) -->
    <form method="get" class="card border-0 shadow-sm mb-3">
        <div class="card-body row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="scope">Who</label>
                <select id="scope" name="scope" class="form-select form-select-sm">
                    <option value="" selected="@(string.IsNullOrEmpty(scope))">Everyone</option>
                    <option value="admin" selected="@(scope == "admin")">Admins only</option>
                    <option value="community" selected="@(scope == "community")">Community</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="action">Action</label>
                <select id="action" name="type" class="form-select form-select-sm">
                    @foreach (var g in actionGroups)
                    {
                        <option value="@g.Value" selected="@((string?)ViewBag.ActionFilter == g.Value || (g.Value == "" && string.IsNullOrEmpty((string?)ViewBag.ActionFilter)))">@g.Label</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small mb-1" for="who">Email contains</label>
                <input id="who" name="who" value="@ViewBag.Who" class="form-control form-control-sm" placeholder="e.g. requester" />
            </div>
            <div class="col-6 col-md-1">
                <label class="form-label small mb-1" for="from">From</label>
                <input id="from" name="from" type="date" value="@ViewBag.From" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-md-1">
                <label class="form-label small mb-1" for="to">To</label>
                <input id="to" name="to" type="date" value="@ViewBag.To" class="form-control form-control-sm" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button class="btn btn-sm btn-danger flex-fill"><i class="fas fa-filter me-1"></i>Filter</button>
                <a asp-action="Audit" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-clipboard-check fa-2x mb-2"></i>
                <div>No audit entries match these filters.</div>
            </div>
        }
        @foreach (var a in Model)
        {
            var st = Style(a.Action);
            <div class="au-row">
                <div class="au-ico @st.Css"><i class="fas @st.Icon"></i></div>
                <div class="flex-grow-1 min-w-0">
                    <div class="small fw-semibold">@a.Details</div>
                    <div class="au-meta mt-1 d-flex flex-wrap gap-2 align-items-center">
                        <span>
                            <i class="fas @(a.ActorIsAdmin ? "fa-user-shield text-danger" : "fa-user") me-1"></i>@a.ActorEmail
                            @if (a.ActorIsAdmin) { <span class="badge bg-danger ms-1" style="font-size:.6rem">ADMIN</span> }
                        </span>
                        <span>·</span>
                        <span title="@a.At.ToString("dd MMM yyyy, HH:mm:ss")">@a.At.ToString("dd MMM yyyy, hh:mm tt")</span>
                        <span class="au-code">@a.Action</span>
                        @if (!string.IsNullOrEmpty(a.EntityType))
                        {
                            <span class="au-code">@a.EntityType @a.EntityId</span>
                        }
                        @if (!string.IsNullOrEmpty(a.IpAddress))
                        {
                            <span title="IP address"><i class="fas fa-network-wired me-1"></i>@a.IpAddress</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Audit pages">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(pageNo <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Audit", Route(pageNo - 1))">Previous</a></li>
                <li class="page-item disabled"><span class="page-link">Page @pageNo of @totalPages</span></li>
                <li class="page-item @(pageNo >= totalPages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Audit", Route(pageNo + 1))">Next</a></li>
            </ul>
        </nav>
    }
</div>
