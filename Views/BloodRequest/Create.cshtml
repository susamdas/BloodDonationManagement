@model BloodDonationManagement.Models.BloodRequest
@{
    ViewData["Title"] = "Request Blood";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.ShowHero = false;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Urgency selector (visual, updates hidden field) -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="mb-3"><i class="fas fa-exclamation-triangle me-2 text-warning"></i>Select Urgency Level</h5>
                    <div class="row g-3" id="urgencyCards">
                        <div class="col-4">
                            <label class="urgency-card card text-center border-2 border-success rounded-3 p-3 cursor-pointer selected" data-value="0" style="cursor:pointer">
                                <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                                <div class="fw-semibold">Normal</div>
                                <small class="text-muted">Planned / Non-emergency</small>
                            </label>
                        </div>
                        <div class="col-4">
                            <label class="urgency-card card text-center border-2 border-warning rounded-3 p-3 cursor-pointer" data-value="1" style="cursor:pointer">
                                <i class="fas fa-exclamation-circle fa-2x text-warning mb-2"></i>
                                <div class="fw-semibold">Urgent</div>
                                <small class="text-muted">Needed within 24 hours</small>
                            </label>
                        </div>
                        <div class="col-4">
                            <label class="urgency-card card text-center border-2 border-danger rounded-3 p-3 cursor-pointer" data-value="2" style="cursor:pointer">
                                <i class="fas fa-skull-crossbones fa-2x text-danger mb-2"></i>
                                <div class="fw-semibold">Critical</div>
                                <small class="text-muted">Life-threatening emergency</small>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Form -->
            <div class="card border-0 shadow-sm" id="requestCard">
                <div class="card-header bg-danger text-white rounded-top" id="cardHeader">
                    <h5 class="mb-0"><i class="fas fa-hand-holding-medical me-2"></i>Blood Request Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="col-12 text-danger small"></div>
                        <div class="col-12">
                            <div class="alert alert-light border small mb-0">
                                <i class="fas fa-wand-magic-sparkles text-danger me-1"></i>
                                After you submit, <b>Smart Matching</b> ranks eligible donors by compatibility, distance and readiness
                                and alerts the best matches instantly. Add the hospital location (GPS) for the most accurate ranking.
                                <br /><i class="fas fa-shield-alt text-warning me-1"></i><b>Blood is free</b> — never pay anyone for blood.
                            </div>
                        </div>
                        <input asp-for="Urgency" type="hidden" id="urgencyInput" value="0" />

                        <div class="col-md-6">
                            <label asp-for="PatientName" class="form-label fw-semibold"></label>
                            <input asp-for="PatientName" class="form-control" placeholder="Full patient name" />
                            <span asp-validation-for="PatientName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BloodGroup" class="form-label fw-semibold">Blood Group Needed *</label>
                            <div class="d-flex flex-wrap gap-2" id="bgBtns">
                                @foreach (var bg in new[] { "A+","A-","B+","B-","AB+","AB-","O+","O-" })
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm bg-btn fw-bold" data-bg="@bg">@bg</button>
                                }
                            </div>
                            <input asp-for="BloodGroup" type="hidden" id="bloodGroupInput" />
                            <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DistrictId" class="form-label fw-semibold">District</label>
                            <select asp-for="DistrictId" class="form-select"
                                    asp-items="@(ViewData["DistrictId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" id="DistrictSel">
                                <option value="">-- Select District --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ThanaId" class="form-label fw-semibold">Thana</label>
                            <select asp-for="ThanaId" class="form-select"
                                    asp-items="@(ViewData["ThanaId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" id="ThanaSel">
                                <option value="">-- Select Thana --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactNo" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">🇧🇩 +88</span>
                                <input asp-for="ContactNo" class="form-control" placeholder="01XXXXXXXXX" />
                            </div>
                            <span asp-validation-for="ContactNo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HospitalName" class="form-label fw-semibold"></label>
                            <input asp-for="HospitalName" class="form-control" placeholder="e.g. Dhaka Medical College Hospital" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UnitsNeeded" class="form-label fw-semibold"></label>
                            <input asp-for="UnitsNeeded" type="number" min="1" max="10" class="form-control" />
                            <span asp-validation-for="UnitsNeeded" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NeededBy" class="form-label fw-semibold"></label>
                            <input asp-for="NeededBy" type="datetime-local" class="form-control" />
                            <span asp-validation-for="NeededBy" class="text-danger small"></span>
                            <div class="form-text">The request closes automatically after this time.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Message" class="form-label fw-semibold">Additional Message</label>
                            <textarea asp-for="Message" class="form-control" rows="3"
                                      placeholder="Any additional details about the patient or situation..."></textarea>
                        </div>

                        <!-- Hospital location: map picker -->
                        <div class="col-12">
                            <label class="form-label fw-semibold mb-1"><i class="fas fa-map-pin text-danger me-1"></i>Hospital location</label>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <button type="button" id="gpsBtn" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-location-arrow me-1"></i>Use my GPS location
                                </button>
                                <span class="small text-muted">or click on the map to place the hospital pin</span>
                                <span id="gpsStatus" class="small text-success ms-auto"></span>
                            </div>
                            <div id="pickMap" class="rounded border" style="height:280px"></div>
                            <div class="row g-2 mt-1">
                                <div class="col-6">
                                    <input asp-for="Latitude" class="form-control form-control-sm" readonly placeholder="Latitude" />
                                </div>
                                <div class="col-6">
                                    <input asp-for="Longitude" class="form-control form-control-sm" readonly placeholder="Longitude" />
                                </div>
                            </div>
                        </div>

                        <!-- Live Smart Matching preview -->
                        <div class="col-12">
                            <div id="matchPreview" class="alert alert-light border small mb-0">
                                <i class="fas fa-wand-magic-sparkles text-danger me-1"></i>
                                Choose a blood group and location to preview how many donors Smart Matching will find.
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-5" id="submitBtn">
                                <i class="fas fa-paper-plane me-1"></i>Submit Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/mapkit.js" asp-append-version="true"></script>
    <script>
        // Urgency card selection
        var urgencyColors = { 0: '#198754', 1: '#fd7e14', 2: '#dc3545' };
        document.querySelectorAll('.urgency-card').forEach(function (card) {
            card.addEventListener('click', function () {
                document.querySelectorAll('.urgency-card').forEach(c => c.classList.remove('selected', 'bg-light'));
                this.classList.add('selected', 'bg-light');
                var val = parseInt(this.dataset.value);
                document.getElementById('urgencyInput').value = val;
                document.getElementById('cardHeader').style.background =
                    'linear-gradient(135deg,' + urgencyColors[val] + ',' + urgencyColors[val] + 'cc)';
            });
        });

        // Blood group button selection
        document.querySelectorAll('.bg-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.bg-btn').forEach(b => b.classList.remove('btn-danger', 'active'));
                document.querySelectorAll('.bg-btn').forEach(b => b.classList.add('btn-outline-danger'));
                this.classList.remove('btn-outline-danger');
                this.classList.add('btn-danger', 'active');
                document.getElementById('bloodGroupInput').value = this.dataset.bg;
            });
        });

        // Pre-select if model has value
        var existingBg = '@Model.BloodGroup';
        if (existingBg) {
            document.querySelectorAll('.bg-btn').forEach(function (btn) {
                if (btn.dataset.bg === existingBg) btn.click();
            });
        }

        // District → Thana cascade + save preferred district for SignalR group
        document.getElementById('DistrictSel').addEventListener('change', function () {
            var id = this.value;
            if (id) localStorage.setItem('preferredDistrictId', id);
            else localStorage.removeItem('preferredDistrictId');
            var sel = document.getElementById('ThanaSel');
            sel.innerHTML = '<option value="">-- Select Thana --</option>';
            if (!id) return;
            fetch('/District/GetThanasByDistrict?districtId=' + id)
                .then(r => r.json())
                .then(data => data.forEach(item => {
                    var opt = document.createElement('option');
                    opt.value = item.value; opt.text = item.text;
                    sel.appendChild(opt);
                }));
        });

        // ---------------- Map picker + live matching preview
        var pickMap = null, pin = null, ring = null;
        var latEl = document.getElementById('Latitude'), lngEl = document.getElementById('Longitude');
        var radiusByUrgency = { 0: 10, 1: 15, 2: 25 };

        function setPin(lat, lng) {
            latEl.value = lat.toFixed(6);
            lngEl.value = lng.toFixed(6);
            if (!pickMap) return;
            if (pin) pin.remove();
            if (ring) ring.remove();
            pin = pickMap.marker(lat, lng, { color: '#dc3545', size: 12, label: '+', html: '<b>Hospital</b>' });
            ring = pickMap.circle(lat, lng, radiusByUrgency[document.getElementById('urgencyInput').value] || 10);
            document.getElementById('gpsStatus').textContent = '✓ Location set';
            refreshPreview();
        }

        MapKit.create('pickMap', { center: [23.78, 90.40], zoom: 11 }).then(function (m) {
            pickMap = m;
            pickMap.onClick(function (lat, lng) { setPin(lat, lng); });
            if (latEl.value && lngEl.value) {
                setPin(parseFloat(latEl.value), parseFloat(lngEl.value));
                pickMap.setView(parseFloat(latEl.value), parseFloat(lngEl.value), 13);
            }
        });

        document.getElementById('gpsBtn').addEventListener('click', function () {
            var btn = this;
            if (!navigator.geolocation) { alert('Geolocation not supported.'); return; }
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Getting location...';
            navigator.geolocation.getCurrentPosition(function (pos) {
                setPin(pos.coords.latitude, pos.coords.longitude);
                if (pickMap) pickMap.setView(pos.coords.latitude, pos.coords.longitude, 14);
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-location-arrow me-1"></i>Use my GPS location';
            }, function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-location-arrow me-1"></i>Use my GPS location';
                document.getElementById('gpsStatus').textContent = 'Could not get location — click the map instead.';
            });
        });

        var previewTimer = null;
        function refreshPreview() {
            clearTimeout(previewTimer);
            previewTimer = setTimeout(function () {
                var bg = document.getElementById('bloodGroupInput').value;
                var box = document.getElementById('matchPreview');
                if (!bg) return;
                var q = new URLSearchParams({
                    bloodGroup: bg,
                    urgency: document.getElementById('urgencyInput').value || '0',
                    districtId: document.getElementById('DistrictSel').value || '',
                    thanaId: document.getElementById('ThanaSel').value || '',
                    lat: latEl.value || '', lng: lngEl.value || ''
                });
                fetch('/api/MapData/match-preview?' + q.toString())
                    .then(function (r) { return r.json(); })
                    .then(function (p) {
                        if (ring) ring.setRadius(p.radiusKm);
                        var cls = p.matched === 0 ? 'alert-warning' : 'alert-success';
                        box.className = 'alert ' + cls + ' border small mb-0';
                        box.innerHTML = '<i class="fas fa-wand-magic-sparkles me-1"></i><b>' + p.matched + '</b> eligible ' +
                            MapKit.esc(bg) + '-compatible donor(s) found' +
                            (p.hasLocation ? ' within <b>' + p.radiusKm + ' km</b>' : ' in the selected area') +
                            (p.expanded ? ' (radius widened automatically)' : '') +
                            (p.matched ? ' · best match <b>' + p.bestScore + '%</b>. The top ' + p.notifyTopN + ' will be alerted when you submit.' : '. Try a wider area or Critical urgency.') +
                            (!p.hasLocation ? '<div class="text-muted mt-1">Tip: set the hospital pin for distance-based ranking.</div>' : '');
                    }).catch(function () { });
            }, 300);
        }
        document.querySelectorAll('.bg-btn, .urgency-card').forEach(function (el) { el.addEventListener('click', function () { setTimeout(refreshPreview, 0); }); });
        document.getElementById('DistrictSel').addEventListener('change', refreshPreview);
        document.getElementById('ThanaSel').addEventListener('change', refreshPreview);
        if (existingBg) refreshPreview();
    </script>
}
