@model BloodDonationManagement.Models.Donor
@{
    ViewData["Title"] = "Donor Details";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.ShowHero = false;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Donor Details</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Full Name</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.FullName</dd>

                        <dt class="col-sm-4 text-muted">Blood Group</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-danger fs-6 px-3">@Model.BloodGroup</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">District</dt>
                        <dd class="col-sm-8">@(Model.District?.Name ?? "—")</dd>

                        <dt class="col-sm-4 text-muted">Thana</dt>
                        <dd class="col-sm-8">@(Model.Thana?.Name ?? "—")</dd>

                        <dt class="col-sm-4 text-muted">Contact No</dt>
                        <dd class="col-sm-8">
                            @if (ViewBag.ShowContact == true)
                            {
                                <a href="tel:@Model.ContactNo" class="text-decoration-none">
                                    <i class="fas fa-phone me-1 text-success"></i>@Model.ContactNo
                                </a>
                            }
                            else
                            {
                                <span class="text-muted"><i class="fas fa-lock me-1"></i>@BloodDonationManagement.Services.PrivacyHelper.MaskPhone(Model.ContactNo)</span>
                                <div class="small text-muted">Shared only when the donor accepts a request.</div>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Last Donation</dt>
                        <dd class="col-sm-8">
                            @if (Model.LastDonationDate.HasValue)
                            {
                                <span>
                                    @Model.LastDonationDate.Value.ToString("dd MMM yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Never donated</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Gender</dt>
                        <dd class="col-sm-8">@Model.Gender</dd>

                        <dt class="col-sm-4 text-muted">Eligibility</dt>
                        <dd class="col-sm-8">
                            @{ var elig = (BloodDonationManagement.Services.EligibilityInfo)ViewBag.Eligibility; }
                            @if (!Model.Status)
                            {
                                <span class="badge bg-secondary">Inactive account</span>
                            }
                            else if (!Model.IsAvailable)
                            {
                                <span class="badge bg-secondary">Alerts paused</span>
                            }
                            else if (elig.IsEligible)
                            {
                                <span class="badge bg-success"><i class="fas fa-heart-pulse me-1"></i>Eligible to donate</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Resting — eligible on @elig.NextEligibleDate?.ToString("dd MMM yyyy") (@elig.DaysRemaining days)</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    @if (ViewBag.CanEdit == true)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.DonorId" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
