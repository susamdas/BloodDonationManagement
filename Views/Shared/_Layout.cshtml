@*
    Compatibility layout: Identity pages (Login, Register, Account) use "_Layout".
    It simply forwards to the main sidebar layout so every page looks the same.
*@
@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

@RenderBody()

@section Head {
    @RenderSection("Head", required: false)
}

@section Scripts {
    @RenderSection("Scripts", required: false)
}
