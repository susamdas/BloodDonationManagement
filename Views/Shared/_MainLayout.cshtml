@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject BloodDonationManagement.Data.ApplicationDbContext Db
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var isAdmin = User.IsInRole("Admin");
    var openReports = isAdmin ? Db.RequestReports.Count(r => r.Status == ReportStatus.Open) : 0;
    var csrf = User.Identity?.IsAuthenticated == true ? Antiforgery.GetAndStoreTokens(Context).RequestToken : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BloodConnect BD</title>
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/bloodico.ico")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="~/css/app.css" rel="stylesheet" asp-append-version="true" />
    <script>
        window.APP_MAPS_KEY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["GoogleMaps:ApiKey"] ?? ""));
        window.APP_CSRF = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(csrf ?? ""));
    </script>
    <style>
        :root {
            --primary: #dc3545;
            --primary-dark: #b02a37;
        }
        body { background: #f8f9fa; }
        .btn-custom {
            background: var(--primary); border: none; padding: 10px 26px;
            font-weight: 600; border-radius: 50px; color: white; transition: all .2s;
        }
        .btn-custom:hover { background: var(--primary-dark); color: white; transform: translateY(-1px); }
        .blood-drop { color: var(--primary); animation: pulse 2s infinite; }
        @@keyframes pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.1)} }
        /* Urgency badges */
        .badge-critical { background: #dc3545; }
        .badge-urgent   { background: #fd7e14; }
        .badge-normal   { background: #198754; }
        /* Notification bell */
        .notif-bell { position: relative; cursor: pointer; }
        .notif-count {
            position: absolute; top: -6px; right: -8px;
            background: var(--primary); color: white;
            border-radius: 50%; width: 18px; height: 18px;
            font-size: 11px; display: none; align-items: center; justify-content: center;
        }
        /* Toast container */
        .user-avatar { width: 30px; height: 30px; border-radius: 50%; background: #fdecee; color: #dc3545; font-weight: 700; font-size: .85rem; display: inline-flex; align-items: center; justify-content: center; }
        .notif-menu { width: 340px; max-width: 92vw; }
        #notifList { max-height: 380px; overflow-y: auto; }
        .notif-item { display: flex; gap: 10px; padding: 10px 14px; border-bottom: 1px solid #f1f3f5; color: inherit; text-decoration: none; }
        .notif-item:hover { background: #f8f9fa; }
        .notif-item.unread { background: #fff5f5; }
        .notif-time { font-size: .7rem; color: #adb5bd; }
        #toastArea { position: fixed; bottom: 24px; right: 24px; z-index: 9999; width: 340px; }
        .blood-toast {
            background: white; border-left: 4px solid var(--primary);
            border-radius: 8px; padding: 14px 16px; margin-top: 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,.15); animation: slideIn .3s ease;
        }
        .blood-toast.critical { border-left-color: #dc3545; }
        .blood-toast.urgent   { border-left-color: #fd7e14; }
        @@keyframes slideIn { from{transform:translateX(100%);opacity:0} to{transform:translateX(0);opacity:1} }
        @@keyframes slideOut { from{transform:translateX(0);opacity:1} to{transform:translateX(110%);opacity:0} }
    </style>
    @RenderSection("Head", required: false)
</head>
<body>
    @{
        var isAuth = User.Identity?.IsAuthenticated == true;
        var userName = User.Identity?.Name ?? "";
        var initial = userName.Length > 0 ? char.ToUpperInvariant(userName[0]) : '?';
    }
    <div class="app-shell">

        <!-- ============================== Sidebar (offcanvas on phones) -->
        <aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
            <div class="sidebar-inner">
                <div class="sidebar-brand">
                    <a href="@Url.Action("Index", "Home")" id="appSidebarLabel">
                        <span class="brand-drop"><i class="fas fa-tint"></i></span>
                        <span>BloodConnect <small>BD</small></span>
                    </a>
                    <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Close menu"></button>
                </div>

                <div class="sidebar-scroll">
                    <a asp-controller="BloodRequest" asp-action="Create" class="btn btn-danger w-100 fw-semibold mb-3">
                        <i class="fas fa-plus me-2"></i>Request blood
                    </a>

                    <div class="side-label">Main</div>
                    <nav class="side-nav" aria-label="Main">
                        <a class="side-link" asp-controller="Home" asp-action="Index" data-match="/"><i class="fas fa-house"></i>Home</a>
                        <a class="side-link" asp-controller="BloodRequest" asp-action="Index" data-match="/BloodRequest"><i class="fas fa-hand-holding-medical"></i>Blood requests</a>
                        <a class="side-link" asp-controller="BloodSearch" asp-action="Index" data-match="/BloodSearch"><i class="fas fa-magnifying-glass"></i>Find donors</a>
                        <a class="side-link" asp-controller="Map" asp-action="Index" data-match="/Map"><i class="fas fa-map-location-dot"></i>Live map</a>
                        <a class="side-link" asp-controller="Donor" asp-action="Index" data-match="/Donor" data-exclude="/Donor/MyProfile"><i class="fas fa-users"></i>Donor list</a>
                    </nav>

                    @if (isAuth)
                    {
                        <div class="side-label">My space</div>
                        <nav class="side-nav" aria-label="My space">
                            <a class="side-link" asp-controller="Donor" asp-action="MyProfile" data-match="/Donor/MyProfile"><i class="fas fa-id-card"></i>My donor profile</a>
                            <a class="side-link" asp-controller="BloodRequest" asp-action="Index" asp-route-status="mine" data-match="?status=mine"><i class="fas fa-list-check"></i>My requests</a>
                            <a class="side-link" href="@Url.Page("/Account/Manage/Index", new { area = "Identity" })" data-match="/Identity/Account/Manage"><i class="fas fa-user-gear"></i>Account &amp; password</a>
                        </nav>
                    }

                    @if (isAdmin)
                    {
                        <div class="side-label">Admin</div>
                        <nav class="side-nav" aria-label="Admin">
                            <a class="side-link" asp-controller="Admin" asp-action="Dashboard" data-match="/Admin/Dashboard"><i class="fas fa-chart-line"></i>Analytics</a>
                            <a class="side-link" asp-controller="Admin" asp-action="Users" data-match="/Admin/Users"><i class="fas fa-users-gear"></i>Users</a>
                            <a class="side-link" asp-controller="Admin" asp-action="Reports" data-match="/Admin/Reports">
                                <i class="fas fa-flag"></i>Reports
                                @if (openReports > 0) { <span class="side-badge">@openReports</span> }
                            </a>
                            <a class="side-link" asp-controller="Admin" asp-action="Audit" data-match="/Admin/Audit"><i class="fas fa-clipboard-list"></i>Audit log</a>
                            <a class="side-link" asp-controller="District" asp-action="Index" data-match="/District"><i class="fas fa-location-arrow"></i>Locations</a>
                        </nav>
                    }
                </div>

                <div class="sidebar-foot">
                    @if (isAuth)
                    {
                        <div class="side-user">
                            <span class="user-avatar">@initial</span>
                            <div class="min-w-0 flex-grow-1">
                                <div class="side-user-name text-truncate">@userName</div>
                                <div class="side-user-role">@(isAdmin ? "Administrator" : "Member")</div>
                            </div>
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                <button type="submit" class="btn btn-sm btn-link side-logout" title="Log out" aria-label="Log out"><i class="fas fa-right-from-bracket"></i></button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm w-100 mb-2" href="@Url.Page("/Account/Login", new { area = "Identity" })"><i class="fas fa-right-to-bracket me-1"></i>Log in</a>
                        <a class="btn btn-light btn-sm w-100 text-danger fw-semibold" href="@Url.Page("/Account/Register", new { area = "Identity" })"><i class="fas fa-user-plus me-1"></i>Create account</a>
                    }
                </div>
            </div>
        </aside>

        <!-- ============================== Main column -->
        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-light d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open menu">
                    <i class="fas fa-bars"></i>
                </button>
                <a href="@Url.Action("Index", "Home")" class="topbar-brand d-lg-none"><i class="fas fa-tint text-danger me-1"></i>BloodConnect</a>
                <div class="topbar-title d-none d-lg-block">@ViewData["Title"]</div>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <a asp-controller="BloodRequest" asp-action="Create" class="btn btn-sm btn-danger d-none d-sm-inline-block"><i class="fas fa-plus me-1"></i>Request blood</a>

                    <!-- Notification bell -->
                    <div class="dropdown">
                        <a class="notif-bell btn btn-light" id="notifBell" href="#" role="button" data-bs-toggle="dropdown"
                           data-bs-auto-close="outside" aria-expanded="false" aria-label="Notifications">
                            <i class="fas fa-bell"></i>
                            <span class="notif-count" id="notifCount">0</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end shadow p-0 notif-menu">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                <strong>Notifications</strong>
                                <small class="text-muted" id="notifHint">Live</small>
                            </div>
                            <div id="notifList">
                                @if (isAuth)
                                {
                                    <div class="text-center text-muted small py-4">Loading…</div>
                                }
                                else
                                {
                                    <div class="text-center text-muted small py-4 px-3">
                                        <a href="@Url.Page("/Account/Login", new { area = "Identity" })">Log in</a> to receive personal alerts when a patient near you needs your blood group.
                                    </div>
                                }
                            </div>
                            @if (isAuth)
                            {
                                <div class="border-top text-center py-2 small">
                                    <a asp-controller="Donor" asp-action="MyProfile" class="text-decoration-none">View my donor profile</a>
                                </div>
                            }
                        </div>
                    </div>

                    @if (isAuth)
                    {
                        <span class="user-avatar d-lg-none" title="@userName">@initial</span>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-secondary d-lg-none" href="@Url.Page("/Account/Login", new { area = "Identity" })">Log in</a>
                    }
                </div>
            </header>

            <main class="app-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="container mt-3">
                        <div class="alert alert-success alert-dismissible fade show flash-alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="container mt-3">
                        <div class="alert alert-danger alert-dismissible fade show flash-alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="container mt-3">
                        <div class="alert alert-info alert-dismissible fade show flash-alert">
                            <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="app-footer">
                <div class="container d-flex flex-wrap justify-content-between gap-3">
                    <div>
                        <strong class="text-danger"><i class="fas fa-tint me-1"></i>BloodConnect BD</strong>
                        <span class="ms-2">Connecting blood donors with those in need across Bangladesh.</span>
                    </div>
                    <div class="d-flex flex-wrap gap-3">
                        <span><i class="fas fa-phone me-1"></i>01714-496737</span>
                        <span><i class="fas fa-envelope me-1"></i>susam.gbit@gmail.com</span>
                        <a href="@Url.Action("Privacy","Home")">Privacy</a>
                    </div>
                </div>
                <div class="container mt-2 small opacity-75">&copy; @DateTime.Now.Year BloodConnect BD · Created by Susam Das</div>
            </footer>
        </div>
    </div>

    <!-- Toast Notification Area -->
    <div id="toastArea"></div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        // Auto-dismiss alerts
        setTimeout(function () {
            document.querySelectorAll('.flash-alert').forEach(function (el) {
                el.style.transition = 'opacity .5s';
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 500);
            });
        }, 5000);

        // Active sidebar link
        (function () {
            var path = window.location.pathname.toLowerCase();
            var full = (path + window.location.search).toLowerCase();
            var best = null, bestLen = -1;
            document.querySelectorAll('.side-link[data-match]').forEach(function (link) {
                var m = link.getAttribute('data-match').toLowerCase();
                var ex = (link.getAttribute('data-exclude') || '').toLowerCase();
                var hit = m === '/' ? (path === '/' || path === '/home' || path === '/home/index')
                        : m.charAt(0) === '?' ? full.indexOf(m) >= 0
                        : path.indexOf(m) === 0;
                if (hit && ex && path.indexOf(ex) === 0) hit = false;
                if (hit && m.length > bestLen) { best = link; bestLen = m.length; }
            });
            if (best) { best.classList.add('active'); best.setAttribute('aria-current', 'page'); }
        })();

        // ---------------- Notifications: stored personal alerts (bell) + live SignalR push
        var isAuthenticated = @((User.Identity?.IsAuthenticated == true).ToString().ToLower());
        var notifItems = [];
        var unreadCount = 0;

        function escHtml(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        function setBadge(n) {
            unreadCount = n;
            var el = document.getElementById('notifCount');
            el.textContent = n > 9 ? '9+' : n;
            el.style.display = n > 0 ? 'flex' : 'none';
        }

        var typeIcon = { danger: 'fa-triangle-exclamation text-danger', warning: 'fa-circle-exclamation text-warning', success: 'fa-circle-check text-success', info: 'fa-bell text-primary' };

        function renderNotifications() {
            if (!isAuthenticated) return;
            var list = document.getElementById('notifList');
            if (!notifItems.length) {
                list.innerHTML = '<div class="text-center text-muted small py-4 px-3"><i class="fas fa-bell-slash d-block mb-2"></i>No notifications yet.</div>';
                return;
            }
            list.innerHTML = notifItems.map(function (n) {
                var tag = n.link ? 'a' : 'div';
                return '<' + tag + (n.link ? ' href="' + escHtml(n.link) + '"' : '') + ' class="notif-item' + (n.isRead ? '' : ' unread') + '">' +
                    '<i class="fas ' + (typeIcon[n.type] || typeIcon.info) + ' mt-1"></i>' +
                    '<div><div class="fw-semibold small">' + escHtml(n.title) + '</div>' +
                    '<div class="small text-muted">' + escHtml(n.message) + '</div>' +
                    '<div class="notif-time">' + escHtml(n.createdAt) + '</div></div></' + tag + '>';
            }).join('');
        }

        function loadNotifications() {
            if (!isAuthenticated) return;
            fetch('/api/notifications', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                    if (!d) return;
                    notifItems = d.items; setBadge(d.unread); renderNotifications();
                }).catch(function () { });
        }

        function markAllRead() {
            if (!isAuthenticated || unreadCount === 0) return;
            fetch('/api/notifications/read-all', { method: 'POST', headers: { 'RequestVerificationToken': window.APP_CSRF } })
                .then(function () { setBadge(0); });
        }

        // Opening the bell marks everything as read (the list keeps highlighting until next load)
        document.getElementById('notifBell').addEventListener('shown.bs.dropdown', markAllRead);

        function showToast(title, body, cls, link) {
            var html = '<div class="blood-toast ' + (cls || '') + '">' +
                '<div class="d-flex justify-content-between align-items-start">' +
                '<strong>' + title + '</strong>' +
                '<button onclick="this.closest(\'.blood-toast\').remove()" class="btn-close btn-sm ms-2" aria-label="Close"></button>' +
                '</div><div class="mt-1 small">' + body + '</div>' +
                (link ? '<a class="small" href="' + escHtml(link) + '">Open</a>' : '') + '</div>';
            var area = document.getElementById('toastArea');
            area.insertAdjacentHTML('afterbegin', html);
            var toast = area.firstElementChild;
            setTimeout(function () {
                toast.style.animation = 'slideOut .3s ease forwards';
                setTimeout(function () { if (toast.parentNode) toast.remove(); }, 300);
            }, 9000);
        }

        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        // Personal notification (e.g. "you are a 92% match", "a donor accepted")
        connection.on("Notify", function (n) {
            notifItems.unshift({ id: n.id, title: n.title, message: n.message, link: n.link, type: n.type, isRead: false, createdAt: n.createdAt });
            notifItems = notifItems.slice(0, 15);
            setBadge(unreadCount + 1);
            renderNotifications();
            var cls = n.type === 'danger' ? 'critical' : (n.type === 'warning' ? 'urgent' : '');
            showToast('<i class="fas fa-bell me-1"></i>' + escHtml(n.title), escHtml(n.message), cls, n.link);
        });

        // Public feed: new request in the district the user follows
        connection.on("NewBloodRequest", function (data) {
            var cls = data.urgency === 'Critical' ? 'critical' : (data.urgency === 'Urgent' ? 'urgent' : '');
            showToast(escHtml(data.urgency) + ' Blood Request',
                '<span class="badge bg-danger me-1">' + escHtml(data.bloodGroup) + '</span>' + escHtml(data.hospital || data.district),
                cls, '/BloodRequest/Details/' + data.bloodRequestId);
        });

        connection.start().then(function () {
            var districtId = localStorage.getItem('preferredDistrictId');
            if (districtId) {
                connection.invoke("JoinDistrictGroup", districtId)
                    .catch(function (err) { console.warn("JoinDistrictGroup:", err); });
            }
        }).catch(function (err) { console.warn("SignalR:", err); });

        loadNotifications();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
